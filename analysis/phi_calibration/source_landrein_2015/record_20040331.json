actic angles on the main stem of Col-0, clasp1 (Col-0), WS-4, bot1-7 (WS-4) single mutants and of combinations of these genotypes", "links": {"self": "https://zenodo.org/api/records/20040331", "self_html": "https://zenodo.org/records/20040331", "preview_html": "https://zenodo.org/records/20040331?preview=1", "doi": "https://doi.org/10.5281/zenodo.20040331", "self_doi": "https://doi.org/10.5281/zenodo.20040331", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20040331", "reserve_doi": "https://zenodo.org/api/records/20040331/draft/pids/doi", "parent": "https://zenodo.org/api/records/20040330", "parent_html": "https://zenodo.org/records/20040330", "parent_doi": "https://doi.org/10.5281/zenodo.20040330", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.20040330", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:20040331/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:20040331/sequence/default", "files": "https://zenodo.org/api/records/20040331/files", "media_files": "https://zenodo.org/api/records/20040331/media-files", "archive": "https://zenodo.org/api/records/20040331/files-archive", "archive_media": "https://zenodo.org/api/records/20040331/media-files-archive", "latest": "https://zenodo.org/api/records/20040331/versions/latest", "latest_html": "https://zenodo.org/records/20040331/latest", "versions": "https://zenodo.org/api/records/20040331/versions", "draft": "https://zenodo.org/api/records/20040331/draft", "access_links": "https://zenodo.org/api/records/20040331/access/links", "access_grants": "https://zenodo.org/api/records/20040331/access/grants", "access_users": "https://zenodo.org/api/records/20040331/access/users", "access_request": "https://zenodo.org/api/records/20040331/access/request", "access": "https://zenodo.org/api/records/20040331/access", "communities": "https://zenodo.org/api/records/20040331/communities", "communities-suggestions": "https://zenodo.org/api/records/20040331/communities-suggestions", "r